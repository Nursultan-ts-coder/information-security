   "source": [
    "1. Save the script to a some directory in your PATH, e.g. /usr/local/bin"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e49d8c03",
   "metadata": {
    "vscode": {
     "languageId": "shellscript"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "\n"
     ]
    }
   ],
   "source": [
    "sudo mv toy_shell.py /usr/local/bin/toy_shell"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "44b391b2",
   "metadata": {},
   "source": [
    "2. Make the script executable:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3ddd0308",
   "metadata": {
    "vscode": {
     "languageId": "shellscript"
    }
   },
   "outputs": [],
   "source": [
    "sudo chmod +x /usr/local/bin/toy_shell"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4c29bffc",
   "metadata": {},
   "source": [
